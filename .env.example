# VoiceKhata — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# Gemini API key — get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini model name — e.g. gemini-2.0-flash
GEMINI_MODEL=gemini-flash-lite-latest

# Supabase project URL — from your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — SERVER SIDE ONLY, never expose to client code
SUPABASE_SERVICE_ROLE_KEY=

# Your shop name — shown in WhatsApp reminder messages (Phase 7)
NEXT_PUBLIC_SHOP_NAME=Hamari Dukaan
